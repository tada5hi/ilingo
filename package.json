{
    "name": "@ilingo/root",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "A lightweight, framework-agnostic translation and internationalization (i18n) library for TypeScript — pluggable stores, BCP-47 fallback, ICU-lite plurals, Intl formatters.",
    "author": {
        "name": "Peter Placzek",
        "email": "contact@tada5hi.net",
        "url": "https://github.com/tada5hi"
    },
    "workspaces": [
        "./packages/*",
        "./docs"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tada5hi/ilingo.git"
    },
    "keywords": [
        "i18n",
        "internationalization",
        "localization",
        "l10n",
        "translate",
        "translation",
        "locale",
        "locales",
        "intl",
        "pluralization",
        "bcp47",
        "typescript",
        "lightweight",
        "tree-shakeable",
        "ssr",
        "edge",
        "server-side",
        "client-side",
        "i18next-alternative"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=22.0.0"
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^13.0.3",
        "@tada5hi/commitlint-config": "^1.3.1",
        "@tada5hi/eslint-config": "^2.3.1",
        "@tada5hi/tsconfig": "^0.7.2",
        "@types/node": "^26.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-plugin-vue": "^10.10.0",
        "husky": "^9.1.7",
        "nx": "^23.1.1",
        "rimraf": "^6.1.2",
        "size-limit": "^13.0.1",
        "tsdown": "^0.22.14",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.66.0",
        "unplugin-vue": "^7.1.0",
        "vitest": "^4.1.5",
        "vue-tsc": "^3.3.9"
    },
    "scripts": {
        "build": "npx nx run-many -t build",
        "test": "npx nx run-many -t test",
        "test:coverage": "npx nx run-many -t test:coverage",
        "size": "size-limit",
        "lint": "eslint",
        "lint:fix": "npm run lint -- --fix",
        "prepare": "husky"
    }
}
